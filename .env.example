# Конфигурация демонов ReactHome
# Зачем: пример файла с переменными окружения для безопасного хранения секретов
# Скопируйте этот файл в .env и заполните реальными значениями
# ВАЖНО: .env находится в .gitignore и не попадает в репозиторий

# UUID демонов (секретные идентификаторы)
DAEMON_UUID_POCHTOVAYA=your-pochtovaya-uuid-here
DAEMON_UUID_LUCHISTOE=your-luchistoe-uuid-here

# URL внешнего WebSocket шлюза
GATE_URL=wss://gate.reacthome.net

# URL локального демона (для logger)
DAEMON_WS_URL=ws://192.168.88.4:3000

# OpenSearch конфигурация
OPENSEARCH_ENABLED=true
OPENSEARCH_URL=https://your-opensearch-url:9200
OPENSEARCH_USER=your-opensearch-user
OPENSEARCH_PASSWORD=your-opensearch-password
OPENSEARCH_INDEX_PREFIX=reacthome-events
OPENSEARCH_CA_CERT=~/.opensearch/root.crt

# Отладочные флаги
DURATION_DEBUG=true
