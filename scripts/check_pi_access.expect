#!/usr/bin/expect -f
#
# Быстрая неинтерактивная проверка доступа к 192.168.88.4 (pi/raspberry)
# Выполняет: hostname, uptime, открытые порты (3000/8088/8188), статус janus,
# и HTTP заголовки локального сервиса на :3000
#

set timeout 8
set host "192.168.88.4"
set user "pi"
set pass "raspberry"

set cmd "hostname; echo '---'; uptime; echo '---'; (ss -lnt 2>/dev/null || netstat -lnt) | egrep ':3000|:8088|:8188' || true; echo '---'; (systemctl is-active janus || true); echo '---'; (curl -sS -m 3 -i http://localhost:3000/ | head -n 15 || true)"

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$host $cmd
expect {
  "*assword:" {
    send "$pass\r"
    exp_continue
  }
  eof
}


